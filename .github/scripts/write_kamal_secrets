#!/usr/bin/env bash
# GitHub Actions 用。環境変数（GitHub Secrets）から config/master.key と .kamal/secrets.<環境> を書き出す。
# どちらも gitignore 済み。手元では .kamal/secrets.<環境> を直接用意するので、このスクリプトは使わない。
#
# GitHub の Secrets 名は GITHUB_ で始められないため、OAuth の値は OAUTH_GITHUB_* で受け取り、
# Kamal の設定（config/deploy.yml）が期待する GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET に書き換える。
# 値は単引用符で囲み、Kamal（dotenv 互換）の $ 展開を防ぐ。値に ' は使えない。
set -euo pipefail

destination="${1:?usage: .github/scripts/write_kamal_secrets <destination>}"
: "${RAILS_MASTER_KEY:?RAILS_MASTER_KEY が設定されていません}"
: "${KAMAL_REGISTRY_PASSWORD:?KAMAL_REGISTRY_PASSWORD が設定されていません}"

secrets_file=".kamal/secrets.${destination}"

printf '%s' "$RAILS_MASTER_KEY" > config/master.key

{
  printf "KAMAL_REGISTRY_PASSWORD='%s'\n" "$KAMAL_REGISTRY_PASSWORD"
  # 以下はデプロイ時のみ必要。管理者付与のワークフローでは渡されないので空なら書かない
  [ -n "${OAUTH_GITHUB_CLIENT_ID:-}" ] && printf "GITHUB_CLIENT_ID='%s'\n" "$OAUTH_GITHUB_CLIENT_ID"
  [ -n "${OAUTH_GITHUB_CLIENT_SECRET:-}" ] && printf "GITHUB_CLIENT_SECRET='%s'\n" "$OAUTH_GITHUB_CLIENT_SECRET"
  [ -n "${STAGING_BASIC_AUTH_PASSWORD:-}" ] && printf "STAGING_BASIC_AUTH_PASSWORD='%s'\n" "$STAGING_BASIC_AUTH_PASSWORD"
  true
} > "$secrets_file"

chmod 600 config/master.key "$secrets_file"
echo "wrote config/master.key and $secrets_file"
