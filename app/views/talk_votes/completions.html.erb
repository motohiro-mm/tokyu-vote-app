<% content_for :title, "投票が完了しました" %>
<h1 class="page-title">投票が完了しました</h1>
<p class="mt-2 text-center text-stone-600">ご投票ありがとうございます！</p>

<div class="mt-6 space-y-3 text-center">
  <% if @remaining_votes.positive? %>
    <%= link_to "続けて#{@category.label}に投票する（残り #{@remaining_votes} 票）", event_talks_path(@event),
                class: "card-link" %>
  <% else %>
    <p class="rounded-lg bg-white px-4 py-3 text-sm text-stone-600">
      <%= @category.label %>の3票分すべての投票が完了しました。
    </p>
  <% end %>
  <%= link_to "TOPへ戻る", event_path(@event),
              class: "card-link" %>
</div>
