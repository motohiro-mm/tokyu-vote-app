<% content_for :title, "#{Event.model_name.human}管理" %>
<div class="mb-6 flex items-center justify-between gap-4">
  <h1 class="page-title text-left"><%= Event.model_name.human %>管理</h1>
  <%= link_to "新規作成", new_admin_event_path, class: "btn-primary" %>
</div>
<p class="mb-6 text-right">
  <%= link_to "管理者の一覧", admin_administrators_path, class: "text-sm text-link" %>
</p>

<% if @events.empty? %>
  <p class="text-tokyu-ink-soft"><%= Event.model_name.human %>がありません。</p>
<% else %>
  <ul class="space-y-4">
    <% @events.each do |event| %>
      <li>
        <%= link_to admin_event_path(event),
                    class: "card-link flex items-center justify-between gap-4" do %>
          <span class="min-w-0 font-bold break-words"><%= event.title %></span>
          <span class="shrink-0 text-sm text-tokyu-ink-soft"><%= event.status_label %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
