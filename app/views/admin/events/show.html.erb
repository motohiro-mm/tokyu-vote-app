<% content_for :title, @event.title %>
<h1 class="page-title mb-6"><%= @event.title %></h1>

<div class="card mb-6">
  <h2 class="section-title mb-2">開催情報</h2>

  <%= form_with model: [ :admin, @event ], method: :patch, html: { id: "event_edition" }, class: "mt-4 space-y-4" do |f| %>
    <% if @event.errors.any? %>
      <ul class="alert-error">
        <% @event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :title, class: "label" %>
      <%= f.text_field :title, class: "input" %>
    </div>

    <div>
      <%= f.label :held_on, class: "label" %>
      <%= f.date_field :held_on, class: "input" %>
    </div>

    <div>
      <%= f.label :slug, class: "label" %>
      <% if @event.slug_in_database.present? %>
        <%= f.text_field :slug, value: @event.slug_in_database, disabled: true, class: "input" %>
        <p class="mt-1 text-sm text-tokyu-ink-soft">配布済みのURLやアーカイブへのリンクを維持するため、設定後は変更できません。</p>
        <p class="mt-1 text-sm">公開URL: <%= link_to event_url(slug: @event.slug_in_database), event_path(slug: @event.slug_in_database), class: "underline" %></p>
      <% else %>
        <%= f.text_field :slug, class: "input", placeholder: "17", spellcheck: false %>
        <p class="mt-1 text-sm text-tokyu-ink-soft">公開URLになります。半角英数字とハイフンのみ。例: 17 なら /17。設定後は変更できません。</p>
      <% end %>
    </div>

    <%= f.submit "保存する", class: "btn-primary" %>
  <% end %>
</div>

<div class="card mb-6">
  <h2 class="section-title mb-2"><%= Event.human_attribute_name(:status) %></h2>
  <p class="mb-4 text-sm text-tokyu-ink-soft">
    現在: <%= @event.status_label %>
  </p>

  <%= form_with model: [ :admin, @event ], method: :patch, html: { id: "event_status" }, class: "flex flex-wrap items-center gap-4" do |f| %>
    <%= f.select :status,
                 Event.statuses.keys.map { |status| [ Event.status_label(status), status ] },
                 {},
                 class: "input w-auto" %>
    <%# 集計中にすると投票が止まり、結果公開にすると参加者に見え、終了にするとトップページから消えるため、押し間違いを一度止める %>
    <%= f.submit "変更する", class: "btn-primary", data: { turbo_confirm: "#{Event.human_attribute_name(:status)}を変更します。よろしいですか？" } %>
  <% end %>
</div>

<%= render "admin/talks/list", event: @event, talks: @talks %>

<div class="card mb-8">
  <h2 class="section-title mb-2">集計</h2>
  <% if @rankings %>
    <p class="mb-4 text-sm text-tokyu-ink-soft">
      参加者には <%= Event.status_label(:closed) %> にするまで見えません。
    </p>

    <div class="space-y-6">
      <% @rankings.each do |title, rows| %>
        <%= render "results/ranking", title: title, rows: rows %>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-tokyu-ink-soft">
      <%= Event.human_attribute_name(:status) %>を <%= Event.status_label(:counting) %> にすると表示されます。
    </p>
  <% end %>
</div>

<div class="text-center">

  <%= link_to "一覧に戻る", admin_events_path, class: "btn-secondary" %>

</div>
