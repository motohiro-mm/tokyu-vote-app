<% content_for :title, @event.title %>
<h1 class="page-title"><%= @event.title %></h1>

<div class="card mt-6">
  <h2 class="section-title">ステータス</h2>
  <p class="mt-1 text-sm text-stone-500">
    現在: <%= @event.status_label %>
  </p>

  <%= form_with model: [ :admin, @event ], method: :patch, class: "mt-4 flex flex-wrap items-center gap-3" do |f| %>
    <%= f.select :status,
                 Event.statuses.keys.map { |status| [ Event.status_label(status), status ] },
                 {},
                 class: "input mt-0 w-auto" %>
    <%= f.submit "変更する", class: "btn-primary" %>
  <% end %>
</div>

<%= render "admin/talks/list", event: @event, talks: @talks %>

<div class="card mt-6">
  <h2 class="section-title">集計</h2>
  <% if @rankings %>
    <p class="mt-1 text-sm text-stone-500">
      参加者には <%= Event.status_label(:closed) %> にするまで見えません。
    </p>

    <div class="mt-4 space-y-6">
      <% @rankings.each do |title, rows| %>
        <%= render "results/ranking", title: title, rows: rows %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-1 text-sm text-stone-500">
      ステータスを <%= Event.status_label(:counting) %> にすると表示されます。
    </p>
  <% end %>
</div>

<%= link_to "一覧に戻る", admin_events_path, class: "btn-secondary mt-6" %>
