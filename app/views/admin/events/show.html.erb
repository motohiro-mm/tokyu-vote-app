<% content_for :title, @event.title %>
<h1 class="text-xl font-bold"><%= @event.title %></h1>

<div class="mt-6 rounded border border-stone-200 bg-white p-5">
  <h2 class="font-bold">ステータス</h2>
  <p class="mt-1 text-sm text-stone-500">
    現在: <%= @event.status_label %>
  </p>

  <%= form_with model: [ :admin, @event ], method: :patch, class: "mt-4 flex flex-wrap items-center gap-3" do |f| %>
    <%= f.select :status,
                 Event.statuses.keys.map { |status| [ Event.status_label(status), status ] },
                 {},
                 class: "rounded border border-stone-300 px-3 py-2" %>
    <%= f.submit "変更する", class: "rounded bg-stone-900 px-4 py-2 text-sm text-white" %>
  <% end %>
</div>

<div class="mt-6 rounded border border-stone-200 bg-white p-5">
  <h2 class="font-bold">集計</h2>
  <% if @rankings %>
    <p class="mt-1 text-sm text-stone-500">
      参加者には <%= Event.status_label(:closed) %> にするまで見えません。
    </p>

    <div class="mt-4 space-y-6">
      <% @rankings.each do |title, rows| %>
        <%= render "ranking", title: title, rows: rows %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-1 text-sm text-stone-500">
      ステータスを <%= Event.status_label(:counting) %> にすると表示されます。
    </p>
  <% end %>
</div>

<%= link_to "一覧に戻る", admin_events_path, class: "mt-6 inline-block text-sm underline" %>
