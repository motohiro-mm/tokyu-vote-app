<% content_for :title, "イベントを作成" %>
<h1 class="page-title">イベントを作成</h1>

<%= form_with model: [ :admin, @event ], class: "mt-6 space-y-4" do |f| %>
  <% if @event.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800">
      <% @event.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-bold" %>
    <%= f.text_field :title, class: "input" %>
  </div>

  <div class="flex items-center justify-center gap-4 pt-6">
    <%= f.submit "作成する", class: "btn-primary" %>
    <%= link_to "一覧に戻る", admin_events_path, class: "btn-secondary" %>
  </div>
<% end %>
