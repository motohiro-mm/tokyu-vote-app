<% content_for :title, "#{Event.model_name.human}を作成" %>
<h1 class="page-title mb-6"><%= Event.model_name.human %>を作成</h1>

<%= form_with model: [ :admin, @event ], class: "space-y-6" do |f| %>
  <% if @event.errors.any? %>
    <ul class="alert-error">
      <% @event.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :title, class: "label" %>
    <%= f.text_field :title, class: "input" %>
  </div>

  <div class="mx-auto grid max-w-sm grid-cols-2 gap-4">
    <%= f.submit "作成する", class: "btn-primary w-full" %>
    <%= link_to "一覧に戻る", admin_events_path, class: "btn-secondary w-full text-center" %>
  </div>
<% end %>
