<div class="card mb-6">
  <div class="mb-4 flex items-center justify-between gap-4">
    <h2 class="section-title">LTの一覧</h2>
    <% if event.accepting_talks? %>
      <%= link_to "LTを登録", new_admin_event_talk_path(event), class: "btn-primary" %>
    <% end %>
  </div>

  <% if event.accepting_talks? %>
    <%= form_with url: admin_event_talk_imports_path(event), class: "mb-4 rounded-xl border-2 border-tokyu-ink bg-tokyu-blue-light p-4" do |f| %>
      <p class="mb-2 text-sm font-bold">CSV で一括登録</p>
      <p class="mb-4 text-xs text-tokyu-ink-soft">
        1 行目をヘッダ <code class="rounded bg-white px-2"><%= TalkCsvImport::HEADERS.values.join(",") %></code> にした UTF-8 の CSV
      </p>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <%= f.file_field :file, accept: "text/csv,.csv", class: "input-file w-auto" %>
        <%= f.submit "登録する", class: "btn-secondary" %>
      </div>
    <% end %>
  <% else %>
    <p class="mb-4 text-sm text-tokyu-ink-soft">
      LTの登録は <%= Event.status_label(:preparing) %>・<%= Event.status_label(:open) %> のあいだだけできます。
    </p>
  <% end %>

  <% if talks.empty? %>
    <p class="text-sm text-tokyu-ink-soft">LTが登録されていません。</p>
  <% else %>
    <ul class="divide-y-2 divide-tokyu-bone">
      <% talks.each do |talk| %>
        <li class="flex items-center gap-4 py-4">
          <div class="min-w-0 flex-1">
            <p class="font-bold break-words"><%= talk.title %></p>
            <p class="text-sm text-tokyu-ink-soft"><%= talk.user_name %></p>
          </div>
          <% if talk.canceled? %>
            <span class="shrink-0 rounded-full bg-tokyu-bone px-2 py-1 text-xs font-bold"><%= talk.status_label %></span>
          <% end %>
          <%= link_to "編集", edit_admin_event_talk_path(event, talk), class: "shrink-0 text-sm text-link" %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
