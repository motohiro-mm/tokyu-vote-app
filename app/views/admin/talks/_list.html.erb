<div class="mt-6 rounded border border-stone-200 bg-white p-5">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="font-bold">LT王の候補</h2>
    <%= link_to "LTを登録", new_admin_event_talk_path(event), class: "rounded bg-stone-900 px-4 py-2 text-sm text-white" %>
  </div>

  <% if talks.empty? %>
    <p class="mt-3 text-sm text-stone-500">LTが登録されていません。</p>
  <% else %>
    <ul class="mt-3 divide-y divide-stone-200">
      <% talks.each do |talk| %>
        <li class="flex items-center gap-4 py-3">
          <div class="min-w-0 flex-1">
            <p class="font-bold break-words"><%= talk.title %></p>
            <p class="text-sm text-stone-500"><%= talk.user_name %></p>
          </div>
          <% if talk.canceled? %>
            <span class="shrink-0 rounded bg-stone-200 px-2 py-1 text-xs text-stone-700"><%= talk.status_label %></span>
          <% end %>
          <%= link_to "編集", edit_admin_event_talk_path(event, talk), class: "shrink-0 text-sm underline" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%# 当日のタイムテーブルから作った CSV を流し込む。見本のヘッダは TalkCsvImport::HEADERS と同じ %>
  <%= form_with url: admin_event_talk_imports_path(event), class: "mt-5 border-t border-stone-200 pt-4" do |f| %>
    <p class="text-sm font-bold">CSV で一括登録</p>
    <p class="mt-1 text-xs text-stone-500">
      1 行目をヘッダ <code class="rounded bg-stone-100 px-1"><%= TalkCsvImport::HEADERS.values.join(",") %></code> にした UTF-8 の CSV
    </p>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <%= f.file_field :file, accept: "text/csv,.csv", class: "text-sm" %>
      <%= f.submit "登録する", class: "rounded border border-stone-300 px-4 py-2 text-sm hover:bg-stone-100" %>
    </div>
  <% end %>
</div>
