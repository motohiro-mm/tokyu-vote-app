<%= form_with model: [ :admin, @event, talk ], class: "space-y-6" do |f| %>
  <% if talk.errors.any? %>
    <ul class="alert-error">
      <% talk.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :user_name, class: "label" %>
    <%= f.text_field :user_name, class: "input" %>
  </div>

  <div>
    <%= f.label :title, class: "label" %>
    <%= f.text_field :title, class: "input" %>
  </div>

  <div>
    <%= f.label :description, "説明【任意】", class: "label" %>
    <span class="mb-2 block text-xs text-tokyu-ink-soft">300文字まで</span>
    <%= f.text_area :description, rows: 5, class: "input" %>
  </div>

  <div>
    <%= f.label :slide_url, "発表資料URL【任意】", class: "label" %>
    <span class="mb-2 block text-xs text-tokyu-ink-soft">http または https の URL、2048文字まで</span>
    <%= f.text_field :slide_url, class: "input" %>
  </div>

  <% if talk.persisted? %>
    <div>
      <%= f.label :status, class: "label" %>
      <span class="mb-2 block text-xs text-tokyu-ink-soft">変更できるのは<%= Event.model_name.human %>が <%= Event.status_label(:preparing) %> のあいだだけ</span>
      <%= f.select :status,
                   Talk.statuses.keys.map { |status| [ Talk.status_label(status), status ] },
                   {},
                   class: "input w-auto" %>
    </div>
  <% end %>

  <div class="mx-auto grid max-w-sm grid-cols-2 gap-4">
    <%= link_to "#{Event.model_name.human}に戻る", admin_event_path(@event), class: "btn-secondary w-full text-center" %>
    <%= f.submit submit_label, class: "btn-primary w-full" %>
  </div>
<% end %>
