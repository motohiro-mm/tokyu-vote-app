<%= form_with model: [ :admin, @event, talk ], class: "mt-6 space-y-4" do |f| %>
  <% if talk.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800">
      <% talk.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :user_name, class: "block text-sm font-bold" %>
    <%= f.text_field :user_name, class: "input" %>
  </div>

  <div>
    <%= f.label :title, class: "block text-sm font-bold" %>
    <%= f.text_field :title, class: "input" %>
  </div>

  <% if talk.persisted? %>
    <div>
      <%= f.label :status, class: "block text-sm font-bold" %>
      <span class="text-xs text-stone-500">変更できるのはイベントが <%= Event.status_label(:preparing) %> のあいだだけ</span>
      <%= f.select :status,
                   Talk.statuses.keys.map { |status| [ Talk.status_label(status), status ] },
                   {},
                   class: "input w-auto" %>
    </div>
  <% end %>

  <div class="flex items-center justify-center gap-4 pt-6">
    <%= f.submit submit_label, class: "btn-primary" %>
    <%= link_to "イベントに戻る", admin_event_path(@event), class: "btn-secondary" %>
  </div>
<% end %>
