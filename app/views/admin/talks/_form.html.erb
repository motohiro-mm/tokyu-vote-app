<%= form_with model: [ :admin, @event, talk ], class: "mt-6 space-y-4" do |f| %>
  <% if talk.errors.any? %>
    <ul class="rounded bg-red-50 px-4 py-3 text-sm text-red-800">
      <% talk.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :user_name, class: "block text-sm font-bold" %>
    <%= f.text_field :user_name, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
  </div>

  <div>
    <%= f.label :title, class: "block text-sm font-bold" %>
    <%= f.text_field :title, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
  </div>

  <% if talk.persisted? %>
    <div>
      <%= f.label :status, class: "block text-sm font-bold" %>
      <span class="text-xs text-stone-500">変更できるのはイベントが <%= Event.status_label(:preparing) %> のあいだだけ</span>
      <%= f.select :status,
                   Talk.statuses.keys.map { |status| [ Talk.status_label(status), status ] },
                   {},
                   class: "mt-1 rounded border border-stone-300 px-3 py-2" %>
    </div>
  <% end %>

  <%= f.submit submit_label, class: "rounded bg-stone-900 px-4 py-2 text-sm text-white" %>
<% end %>

<%= link_to "イベントに戻る", admin_event_path(@event), class: "mt-6 inline-block text-sm underline" %>
