<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Tokyu.rb" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tokyu.rb">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% description = "TokyuRuby会議のエントリー・投票アプリ" %>
    <meta name="description" content="<%= description %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Tokyu.rb">
    <meta property="og:title" content="Tokyu.rb">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= "#{request.base_url}/ogp.png" %>">
    <meta name="twitter:card" content="summary_large_image">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;700&family=M+PLUS+Rounded+1c:wght@400;700;800&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# 写真の拡大表示（shared/_zoomable_image）はどの画面からでも開けるよう body に置く。
        画面を移動する前に閉じておかないと、開いたままの状態が Turbo のキャッシュに残る %>
  <body class="flex min-h-screen flex-col bg-dots font-sans text-tokyu-ink"
        data-controller="lightbox"
        data-action="turbo:before-cache@document->lightbox#close">
    <%# 本番と見分けがつかないと投票の取り違えが起きるため、staging 環境では必ず出す %>
    <% if staging? %>
      <div class="bg-red-600 py-1 text-center text-sm text-white">
        staging 環境です。
      </div>
    <% end %>

    <%= render "shared/header" %>

    <main class="mx-auto mb-12 w-full max-w-3xl flex-1 px-4 sm:px-6">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="border-t-3 border-tokyu-ink bg-white py-6 text-center text-xs">
      <%= link_to "利用規約", terms_path, class: "mr-2 hover:underline" %>
      <span class="mr-2">/</span>
      <%= link_to "プライバシーポリシー", privacy_path, class: "hover:underline" %>
    </footer>

    <%# 会場ではスマホで片手で見るため、×ボタンだけでなく画面のどこを押しても閉じる %>
    <%# ブラウザ標準の dialog は最大幅が画面より少し狭く、横長の写真の右端が切れるため外す。大きさは写真の max-w / max-h で抑える %>
    <dialog class="m-auto max-h-none max-w-none overflow-visible bg-transparent p-0 backdrop:bg-tokyu-ink/85"
            aria-label="拡大した写真"
            data-lightbox-target="dialog"
            data-action="click->lightbox#close close->lightbox#clear">
      <%# 画面の角だと写真から離れて見つけにくいので、写真の右上のすぐ外に置く（写真に重ねると写真が隠れる）。
          <dialog> は写真の大きさに合わせて縮むので、dialog を基準に置けば写真の角になる %>
      <button type="button" aria-label="閉じる"
              class="absolute right-0 bottom-full mb-2 flex size-12 cursor-pointer items-center justify-center rounded-full border-3 border-tokyu-ink bg-white text-2xl font-extrabold text-tokyu-ink shadow-sticker focus:outline-none focus-visible:ring-4 focus-visible:ring-tokyu-blue/40">
        ×
      </button>
      <img alt="" class="max-h-[80dvh] max-w-[92vw] rounded-xl border-3 border-white object-contain" data-lightbox-target="image">
    </dialog>
  </body>
</html>
