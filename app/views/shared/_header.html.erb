<header class="border-b border-stone-200 bg-white">
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-5 py-3">
    <%= link_to "TokyuRubyVote", root_path, class: "font-bold" %>

    <% if current_user %>
      <div class="flex items-center gap-3 text-sm">
        <span class="text-stone-600"><%= current_user.name %></span>
        <% if current_user.admin? %>
          <%= link_to "管理", admin_events_path, class: "underline" %>
        <% end %>
        <%= button_to "ログアウト", logout_path, method: :delete, class: "underline" %>
      </div>
    <% end %>
  </div>
</header>
