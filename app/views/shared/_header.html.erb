<% admin_screen = controller_path.start_with?("admin/") %>
<header class="mb-8 border-b-3 border-tokyu-ink <%= admin_screen ? "bg-tokyu-navy text-white" : "bg-tokyu-blue text-tokyu-ink" %>">
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-4 py-2 sm:px-6">
    <div class="flex min-w-0 items-center gap-2">
      <%= link_to root_path, class: "flex shrink-0 items-center gap-2" do %>
        <%= image_tag "tokyu-rb-logo.png", alt: "", class: "size-10 sm:size-12" %>
        <%# 管理画面はバッジとリンクが増えてスマホ幅に収まらないため、ロゴ画像だけにする %>
        <span class="<%= "hidden sm:inline" if admin_screen %> font-display text-lg font-bold sm:text-xl">TokyuRubyVote</span>
      <% end %>
      <% if admin_screen %>
        <span class="shrink-0 rounded-full bg-white/20 px-2 py-1 text-xs font-bold">管理画面</span>
      <% end %>
    </div>

    <% if current_user %>
      <div class="flex min-w-0 items-center gap-4 text-sm font-bold whitespace-nowrap">
        <span class="hidden truncate sm:inline"><%= current_user.name %></span>
        <% if current_user.admin? %>
          <%= link_to "管理画面", admin_events_path, class: "shrink-0 hover:underline" %>
        <% end %>
        <%= button_to "ログアウト", logout_path, method: :delete,
                      class: "min-h-10 shrink-0 cursor-pointer rounded-full border-3 border-tokyu-ink bg-white px-4 text-tokyu-ink hover:bg-tokyu-blue-light" %>
      </div>
    <% end %>
  </div>
</header>
