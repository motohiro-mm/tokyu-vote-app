<% admin_screen = controller_path.start_with?("admin/") %>
<header class="mb-8 border-b-3 border-tokyu-ink <%= admin_screen ? "bg-tokyu-navy text-white" : "bg-tokyu-blue text-tokyu-ink" %>">
  <div class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-2 sm:px-6">
    <div class="flex min-w-0 items-center gap-2">
      <%= link_to root_path, class: "flex shrink-0 items-center gap-2" do %>
        <%= image_tag "tokyu-rb-logo.png", alt: "", class: "size-10 sm:size-12" %>
        <%# 管理者はリンクが増えてスマホ幅では入りきらないので見た目だけ隠す（ロゴ画像にも Tokyu.rb とある） %>
        <span class="<%= "sr-only sm:not-sr-only" if admin_screen || current_user&.admin? %> font-display text-lg font-bold sm:text-xl">Tokyu.rb</span>
      <% end %>
      <% if admin_screen %>
        <span class="shrink-0 rounded-full bg-white/20 px-2 py-1 text-xs font-bold">管理画面</span>
      <% end %>
    </div>

    <% if current_user %>
      <%# 管理者はスマホ幅でリンクが増えて2段に折り返すので、そのときだけ文字を小さくする %>
      <div class="ml-auto flex min-w-0 items-center gap-2 font-bold whitespace-nowrap sm:gap-4 <%= current_user.admin? ? "text-xs sm:text-sm" : "text-sm" %>">
        <%# 長い名前だと 640px 付近で入りきらないので、名前は 768px から出す %>
        <span class="hidden max-w-36 truncate md:inline"><%= current_user.name %></span>
        <%# 文字だけだと指で押せる範囲が狭いので、隣のログアウトボタンと同じ高さを持たせる %>
        <%= link_to "マイページ", mypage_path, class: "inline-flex min-h-10 shrink-0 items-center hover:underline" %>
        <% if current_user.admin? %>
          <%= link_to "管理画面", admin_events_path, class: "inline-flex min-h-10 shrink-0 items-center hover:underline" %>
        <% end %>
        <%= button_to "ログアウト", logout_path, method: :delete,
                      class: "min-h-10 shrink-0 cursor-pointer rounded-full border-3 border-tokyu-ink bg-white px-3 text-tokyu-ink hover:bg-tokyu-blue-light sm:px-4" %>
      </div>
    <% end %>
  </div>
</header>
