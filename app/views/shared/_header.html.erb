<% admin_screen = controller_path.start_with?("admin/") %>
<header class="<%= admin_screen ? "bg-tokyu-navy" : "bg-tokyu-blue" %>">
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-5 py-3">
    <div class="flex items-center gap-3">
      <%= link_to "TokyuRubyVote", root_path, class: "text-lg font-bold text-white" %>
      <% if admin_screen %>
        <span class="rounded-full bg-white/20 px-2 py-0.5 text-xs font-bold text-white">管理画面</span>
      <% end %>
    </div>

    <% if current_user %>
      <div class="flex min-w-0 items-center gap-3 text-sm whitespace-nowrap">
        <span class="truncate text-white"><%= current_user.name %></span>
        <% if current_user.admin? %>
          <%= link_to "管理画面", admin_events_path, class: "shrink-0 font-bold text-white hover:underline" %>
        <% end %>
        <%= button_to "ログアウト", logout_path, method: :delete,
                      class: "shrink-0 rounded-full bg-white/20 px-3 py-1 text-white hover:bg-white/30" %>
      </div>
    <% end %>
  </div>
</header>
