<% flash.each do |type, message| %>
  <% style = type.to_s == "alert" ? "border-red-700 bg-red-50 text-red-800" : "border-tokyu-ink bg-white" %>
  <div class="mb-6 flex items-center gap-4 rounded-xl border-3 px-4 py-2 text-sm font-bold <%= style %>" data-controller="dismiss">
    <p class="flex-1"><%= message %></p>
    <button type="button" aria-label="閉じる" data-action="click->dismiss#close"
            class="size-10 shrink-0 cursor-pointer rounded-full text-lg leading-none hover:bg-black/10">&times;</button>
  </div>
<% end %>
