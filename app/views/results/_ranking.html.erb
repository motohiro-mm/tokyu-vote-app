<section>
  <h3 class="text-sm font-bold"><%= title %></h3>

  <% if rows.empty? %>
    <p class="mt-1 text-sm text-stone-500">まだ票がありません。</p>
  <% else %>
    <ol class="mt-1">
      <% rows.each do |row| %>
        <li class="flex items-baseline gap-3 border-b border-stone-100 py-2 text-sm last:border-0">
          <span class="w-8 shrink-0 text-stone-500"><%= row.rank %>位</span>
          <span class="min-w-0 flex-1 break-words">
            <%# 合算王は個々の作品ではなく人を並べるため作品名を持たない %>
            <% if row.title.present? %>
              <span class="font-bold"><%= row.title %></span>
              <span class="text-stone-500">（<%= row.name %>）</span>
            <% else %>
              <span class="font-bold"><%= row.name %></span>
            <% end %>
          </span>
          <span class="shrink-0"><%= row.vote_count %>票</span>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
