<section>
  <h3 class="mb-2 text-sm font-extrabold"><%= title %></h3>

  <% if rows.empty? %>
    <p class="text-sm text-tokyu-ink-soft">まだ票がありません。</p>
  <% else %>
    <ol>
      <% rows.each do |row| %>
        <li class="flex items-baseline gap-4 border-b-2 border-tokyu-bone py-2 text-sm last:border-0">
          <span class="w-10 shrink-0 font-display text-base font-bold text-tokyu-pink-dark"><%= row.rank %>位</span>
          <span class="min-w-0 flex-1 break-words">
            <%# 合算王は個々の作品ではなく人を並べるため作品名を持たない %>
            <% if row.title.present? %>
              <span class="block font-bold"><%= row.title %></span>
              <span class="block text-tokyu-ink-soft"><%= row.name %></span>
            <% else %>
              <span class="block font-bold"><%= row.name %></span>
              <% if row.entry_titles.any? %>
                <span class="block text-tokyu-ink-soft"><%= row.entry_titles.join("・") %></span>
              <% end %>
            <% end %>
          </span>
          <span class="shrink-0 font-bold"><%= row.vote_count %>票</span>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
