<% content_for :title, "#{@category.label}の結果" %>
<p class="mb-2 text-center text-sm text-tokyu-ink-soft"><%= @event.title %><% if @event.held_on %>（<%= l(@event.held_on, format: :long) %>）<% end %></p>
<h1 class="page-title mb-6"><%= @category.label %>の結果</h1>

<%= render "results/result", result: @result, image_src: ->(image) { url_for(image) } %>

<div class="text-center">

  <%= link_to "戻る", event_path(@event.slug), class: "btn-secondary" %>

</div>
