<% content_for :title, "#{@category.label}の結果" %>
<p class="text-center text-sm text-stone-500">
  <%= @event.title %><% if @event.held_on %>（<%= l(@event.held_on, format: :long) %>）<% end %>
</p>
<h1 class="page-title mt-1"><%= @category.label %>の結果</h1>

<%= render "results/result", result: @result, image_src: ->(image) { url_for(image) } %>

<div class="mt-8 text-center">

  <%= link_to "戻る", event_path(@event.slug), class: "btn-secondary" %>

</div>
