<%# 静的書き出しでは画像の置き場所が変わるため、画像の URL は呼び出し側から image_src で受け取る %>
<% if targets.empty? %>
  <p class="mb-8 text-sm text-tokyu-ink-soft">コメントはありませんでした。</p>
<% else %>
  <ul class="mb-8 space-y-4">
    <% targets.each do |target| %>
      <li class="card">
        <div class="mb-4 flex items-center gap-4">
          <% if target.image %>
            <%= image_tag image_src.call(target.image), alt: target.title, class: "size-16 shrink-0 rounded-xl border-2 border-tokyu-ink object-cover" %>
          <% end %>
          <div class="min-w-0 flex-1">
            <p class="font-bold break-words"><%= target.title %></p>
            <p class="text-sm text-tokyu-ink-soft"><%= target.name %></p>
          </div>
        </div>

        <ul class="space-y-2">
          <% target.comments.each do |comment| %>
            <li class="whitespace-pre-wrap break-words rounded-xl bg-tokyu-blue-light px-4 py-2 text-sm"><%= comment %></li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
<% end %>
