<div class="mt-6 rounded border border-stone-200 bg-white p-5">
  <h2 class="font-bold">ランキング</h2>
  <div class="mt-4 space-y-6">
    <% result.rankings.each do |title, rows| %>
      <%= render "results/ranking", title: title, rows: rows %>
    <% end %>
  </div>
</div>

<h2 class="mt-8 font-bold">エントリーとコメント</h2>
<%= render "results/targets", targets: result.targets, image_src: image_src %>
