<% content_for :title, "投票する" %>
<h1 class="page-title">投票する</h1>

<ul class="mt-6 space-y-3">
  <% @categories.each do |category| %>
    <li>
      <%= link_to category.talk? ? event_talks_path(@event.slug) : event_entries_path(@event.slug, category: category.category_name),
                  class: "card-link" do %>
        <span class="block font-bold"><%= category.label %>に投票する</span>
        <span class="mt-1 block text-sm text-stone-500"><%= category.description %></span>
      <% end %>
    </li>
  <% end %>
</ul>

<div class="mt-8 text-center">

  <%= link_to "戻る", event_path(@event.slug), class: "btn-secondary" %>

</div>
