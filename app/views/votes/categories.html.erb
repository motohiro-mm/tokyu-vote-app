<% content_for :title, "投票する" %>
<h1 class="text-xl font-bold">投票する</h1>

<ul class="mt-6 space-y-3">
  <% @categories.each do |category| %>
    <li>
      <%# LT王だけ投票対象が talks なのでリンク先が変わる %>
      <%= link_to category.talk? ? event_talks_path(@event) : event_entries_path(@event, category: category.category_name),
                  class: "block rounded border border-stone-200 bg-white px-5 py-4 hover:bg-stone-100" do %>
        <span class="font-bold"><%= category.label %>に投票する</span>
        <span class="ml-2 text-sm text-stone-500"><%= category.description %></span>
      <% end %>
    </li>
  <% end %>
</ul>

<%= link_to "戻る", event_path(@event), class: "mt-6 inline-block text-sm underline" %>
