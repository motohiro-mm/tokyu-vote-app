<% content_for :title, "ログイン" %>
<div class="mb-8 text-center">
  <h1 class="page-title mb-4">TokyuRuby会議</h1>
  <p class="leading-relaxed">
    本日はご来場いただき誠にありがとうございます。<br>
    <%= Category.for_entries.joined_label %>へのエントリーと、<%= Category.joined_label %>への投票ができます。
  </p>
</div>

<div class="mb-6 text-center">
  <% if github_configured? %>
    <%# GitHub への遷移はクロスオリジンのリダイレクトなので、Turbo の fetch では追えない %>
    <%= button_to "GitHub でログインする", "/auth/github", data: { turbo: false },
                  class: "btn-primary min-h-14 px-10 text-base", form_class: "inline-block" %>
  <% else %>
    <p class="rounded-xl bg-white px-4 py-2 text-sm text-tokyu-ink-soft">
      GitHub ログインは設定されていません。環境変数
      <code class="rounded bg-tokyu-blue-light px-2">GITHUB_CLIENT_ID</code> と
      <code class="rounded bg-tokyu-blue-light px-2">GITHUB_CLIENT_SECRET</code> を設定してください。
    </p>
  <% end %>
</div>

<% if Rails.env.development? %>
  <div class="rounded-xl border-2 border-dashed border-amber-400 bg-amber-50 p-4 sm:p-6">
    <h2 class="mb-2 font-bold text-amber-900">開発用ログイン</h2>
    <p class="mb-4 text-sm text-amber-800">GitHub を設定していない手元の環境で、ユーザーを切り替えて画面を確認するためのものです。</p>

    <% if @users.blank? %>
      <p class="text-sm text-amber-800">
        ユーザーがいません。<code class="rounded bg-tokyu-blue-light px-2">bin/rails demo:setup</code> を実行してください。
      </p>
    <% else %>
      <ul class="space-y-2">
        <% @users.each do |user| %>
          <li>
            <%= button_to dev_sessions_path(user_id: user.id),
                          class: "w-full cursor-pointer rounded-lg border border-amber-300 bg-white px-4 py-2 text-left text-sm hover:bg-amber-100" do %>
              <%= user.name %><%= " （管理者）" if user.admin? %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
