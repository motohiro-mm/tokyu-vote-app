<% content_for :title, "ログイン" %>
<div class="text-center">
  <h1 class="page-title">TokyuRuby会議</h1>
  <p class="mt-4 leading-relaxed text-stone-700">
    本日はご来場いただき誠にありがとうございます。<br>
    このアプリは、飯王と酒王への参加登録と投票のためのアプリです。
  </p>
</div>

<ul class="mt-6 space-y-4">
  <li class="card">
    <p class="section-title">エントリー</p>
    <p class="mt-1 text-sm text-stone-700">飯王と酒王へエントリーしたい料理・お酒を登録できます。</p>
  </li>
  <li class="card">
    <p class="section-title">投票</p>
    <p class="mt-1 text-sm text-stone-700">飯王・酒王・LT王に対して、それぞれ3票ずつ投票できます。</p>
  </li>
  <li class="card">
    <p class="section-title">投票結果</p>
    <p class="mt-1 text-sm text-stone-700">集計後、投票結果と感想を見ることができます。</p>
  </li>
</ul>

<div class="card mt-6">
  <p class="text-sm text-stone-600">GitHub アカウントでログインします。</p>
  <% if github_configured? %>
    <%# GitHub への遷移はクロスオリジンのリダイレクトなので、Turbo の fetch では追えない %>
    <%= button_to "GitHub でログインする", "/auth/github", data: { turbo: false },
                  class: "btn-primary mt-3" %>
  <% else %>
    <p class="mt-3 rounded-lg bg-tokyu-blue-light px-3 py-2 text-sm text-stone-500">
      GitHub ログインは設定されていません。環境変数
      <code class="rounded bg-white px-1">GITHUB_CLIENT_ID</code> と
      <code class="rounded bg-white px-1">GITHUB_CLIENT_SECRET</code> を設定してください。
    </p>
  <% end %>
</div>

<% if Rails.env.development? %>
  <div class="mt-6 rounded border border-dashed border-amber-400 bg-amber-50 p-5">
    <h2 class="font-bold text-amber-900">開発用ログイン</h2>
    <p class="mt-1 text-sm text-amber-800">GitHub を設定していない手元の環境で、ユーザーを切り替えて画面を確認するためのものです。</p>

    <% if @users.blank? %>
      <p class="mt-3 text-sm text-amber-800">
        ユーザーがいません。<code class="rounded bg-white px-1">bin/rails demo:setup</code> を実行してください。
      </p>
    <% else %>
      <ul class="mt-3 space-y-2">
        <% @users.each do |user| %>
          <li>
            <%= button_to dev_sessions_path(user_id: user.id),
                          class: "w-full rounded border border-amber-300 bg-white px-3 py-2 text-left text-sm hover:bg-amber-100" do %>
              <%= user.name %><%= " （管理者）" if user.admin? %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
