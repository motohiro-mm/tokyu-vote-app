<% content_for :title, "登録が完了しました" %>
<h1 class="text-xl font-bold">登録が完了しました</h1>
<p class="mt-2 text-stone-600">ご参加ありがとうございます。</p>

<div class="mt-6 space-y-3">
  <%= link_to "続けて#{@category.label}に登録する", new_event_entry_path(@event, category: @category.category_name),
              class: "block rounded border border-stone-200 bg-white px-5 py-4 hover:bg-stone-100" %>
  <%= link_to "TOPへ戻る", event_path(@event),
              class: "block rounded border border-stone-200 bg-white px-5 py-4 hover:bg-stone-100" %>
</div>
