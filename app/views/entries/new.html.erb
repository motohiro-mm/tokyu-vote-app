<% content_for :title, "#{@category.label}に登録" %>
<h1 class="page-title mb-6"><%= @category.label %>に登録</h1>

<% if @my_entries.present? %>
  <div class="card mb-6 text-sm">
    <p class="mb-2 font-bold">登録済みの作品</p>
    <ul class="space-y-2 text-tokyu-ink-soft">
      <% @my_entries.each do |entry| %>
        <li><%= entry.title %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @entry, url: event_entries_path(@event.slug, category: @category.category_name),
              class: "space-y-6" do |f| %>
  <% if @entry.errors.any? %>
    <ul class="alert-error">
      <% @entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :title, @category.title_label, class: "label" %>
    <%= f.text_field :title, class: "input" %>
  </div>

  <div>
    <%= f.label :description, "説明（アピールポイント）【任意】", class: "label" %>
    <span class="mb-2 block text-xs text-tokyu-ink-soft">300文字まで</span>
    <%= f.text_area :description, rows: 5, class: "input" %>
  </div>

  <div data-controller="thumbnail-picker">
    <%= f.label :images, "画像【任意】", class: "label" %>
    <span id="entry-images-hint" class="mb-2 block text-xs text-tokyu-ink-soft">
      JPEG / PNG / HEIF（HEIC）、1枚<%= Entry::IMAGE_MAX_SIZE / 1.megabyte %>MBまで、最大<%= Entry::IMAGE_MAX_COUNT %>枚
    </span>
    <%= f.file_field :images, multiple: true, include_hidden: false, class: "input-file",
                     accept: (Entry::IMAGE_CONTENT_TYPES + %w[.heic .heif]).join(","),
                     aria: { describedby: "entry-images-hint" },
                     data: { thumbnail_picker_target: "input", action: "change->thumbnail-picker#render" } %>

    <%# ラジオボタンだけでは何を選ぶのか伝わらないため、選ぶ目的と選ばなかったときの扱いを書く %>
    <fieldset class="mt-4" hidden aria-describedby="entry-thumbnail-hint" data-thumbnail-picker-target="fieldset">
      <legend class="label">一覧に表示する画像</legend>
      <span id="entry-thumbnail-hint" class="mb-2 block text-xs text-tokyu-ink-soft">
        投票ページの一覧で最初に表示する1枚を選んでください（選ばなければ1枚目）
      </span>
      <div class="grid grid-cols-3 gap-3 sm:grid-cols-5" data-thumbnail-picker-target="options"></div>
    </fieldset>
    <template data-thumbnail-picker-target="template">
      <label class="flex cursor-pointer flex-col items-center gap-1 rounded-xl border-3 border-tokyu-ink bg-white p-2 has-checked:bg-tokyu-blue-light">
        <img alt="" class="aspect-square w-full rounded-lg object-cover">
        <span data-name class="w-full truncate text-center text-xs text-tokyu-ink-soft"></span>
        <input type="radio" name="thumbnail_index" class="size-5 accent-tokyu-blue">
      </label>
    </template>
  </div>

  <div class="mx-auto grid max-w-sm grid-cols-2 gap-4">
    <%= link_to "戻る", event_entries_categories_path(@event.slug), class: "btn-secondary w-full text-center" %>
    <%= f.submit "登録する", class: "btn-primary w-full" %>
  </div>
<% end %>
