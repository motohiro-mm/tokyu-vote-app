<% content_for :title, "#{@category.label}に登録" %>
<h1 class="page-title"><%= @category.label %>に登録</h1>

<% if @my_entries.present? %>
  <div class="card mt-4 text-sm">
    <p class="font-bold">登録済みの作品</p>
    <ul class="mt-1 text-stone-600">
      <% @my_entries.each do |entry| %>
        <li class="py-1"><%= entry.title %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @entry, url: event_entries_path(@event, category: @category.category_name),
              class: "mt-6 space-y-4" do |f| %>
  <% if @entry.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800">
      <% @entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :title, "作品名", class: "block text-sm font-bold" %>
    <%= f.text_field :title, class: "input" %>
  </div>

  <div>
    <%= f.label :description, "説明（アピールポイント）【任意】", class: "block text-sm font-bold" %>
    <span class="text-xs text-stone-500">300文字まで</span>
    <%= f.text_area :description, rows: 5, class: "input" %>
  </div>

  <div>
    <%= f.label :image, "画像【任意】", class: "block text-sm font-bold" %>
    <span class="text-xs text-stone-500">JPEG / PNG / GIF、<%= Entry::IMAGE_MAX_SIZE / 1.megabyte %>MB まで</span>
    <%= f.file_field :image, accept: Entry::IMAGE_CONTENT_TYPES.join(","), class: "input-file" %>
  </div>

  <div class="mt-4 text-center">

    <%= f.submit "登録する", class: "btn-primary" %>

  </div>
<% end %>

<div class="mt-8 text-center">

  <%= link_to "戻る", event_entries_categories_path(@event), class: "btn-secondary" %>

</div>
