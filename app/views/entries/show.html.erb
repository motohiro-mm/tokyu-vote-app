<%# 一覧の「自分の作品」バッジから見返しに来る画面なので、自分の作品では投票の見出しを出さない %>
<% heading = @entry.user_id == current_user.id ? "自分の作品" : "投票する" %>
<% content_for :title, heading %>
<h1 class="page-title mb-6"><%= heading %></h1>

<div class="card mb-6">
  <% images = @entry.display_images %>
  <%# 縦に並べると写真が多いエントリーで説明と投票欄が遠くなるため、2枚以上は正方形で横に並べ、押したら写真全体を拡大して見せる。
      1枚だけのときは小さくする理由がないので横幅いっぱいに出す %>
  <% if images.size == 1 %>
    <%= render "shared/zoomable_image", src: images.first, full_src: url_for(images.first), alt: @entry.title,
                                        button_class: "mb-4 block w-full", image_class: "w-full rounded-xl border-2 border-tokyu-ink object-cover" %>
  <% elsif images.any? %>
    <div class="mb-4 grid grid-cols-3 gap-2">
      <% images.each do |image| %>
        <%= render "shared/zoomable_image", src: image, full_src: url_for(image), alt: @entry.title,
                                            button_class: "block", image_class: "aspect-square w-full rounded-xl border-2 border-tokyu-ink object-cover" %>
      <% end %>
    </div>
  <% end %>
  <p class="mb-2 text-lg font-bold break-words">「<%= @entry.title %>」</p>
  <p class="mb-4 text-tokyu-ink-soft last:mb-0"><%= @entry.user.name %></p>
  <% if @entry.description.present? %>
    <p class="whitespace-pre-wrap break-words"><%= @entry.description %></p>
  <% end %>
</div>

<div class="card mb-8">
  <% if @entry.user_id == current_user.id %>
    <p class="text-sm text-tokyu-ink-soft">自分のエントリーには投票できません。</p>
  <% elsif @cast_vote %>
    <div class="mb-6 last:mb-0">
      <p class="mb-2 text-sm font-bold text-tokyu-pink-dark last:mb-0">このエントリーには投票済みです。</p>
      <% if @cast_vote.comment.present? %>
        <p class="text-sm whitespace-pre-wrap break-words text-tokyu-ink-soft"><%= @cast_vote.comment %></p>
      <% end %>
    </div>
    <% if @event.open? %>
      <div class="text-center">
        <%= button_to "投票を取り消す", event_vote_path(@event.slug, @cast_vote), method: :delete, class: "btn-secondary",
                    form: { data: { turbo_confirm: "投票を取り消します。コメントも消えます。よろしいですか？" } } %>
      </div>
    <% end %>
  <% elsif !@event.open? %>
    <p class="text-sm text-tokyu-ink-soft">投票を受け付けていません。</p>
  <% elsif @remaining_votes <= 0 %>
    <p class="text-sm text-tokyu-ink-soft">この部門の票を使い切りました。</p>
  <% else %>
    <%= form_with model: @vote, url: event_votes_path(@event.slug) do |f| %>
      <%= f.hidden_field :entry_id, value: @entry.id %>
      <%= f.label :comment, "コメントを記入する【任意】", class: "label" %>
      <span class="mb-2 block text-xs text-tokyu-ink-soft">300文字まで</span>
      <%= f.text_area :comment, rows: 5,
                      class: "input mb-6" %>
      <div class="text-center">
        <%= f.submit "投票する（残り #{@remaining_votes} 票）",
                   class: "btn-primary" %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="text-center">

  <%= link_to "戻る", event_entries_path(@event.slug, category: @category.category_name),
            class: "btn-secondary" %>

</div>
