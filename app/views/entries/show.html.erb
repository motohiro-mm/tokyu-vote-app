<% content_for :title, "投票する" %>
<h1 class="page-title mb-6">投票する</h1>

<div class="card mb-6">
  <% if @entry.image.attached? %>
    <%= image_tag @entry.image, alt: @entry.title, class: "mb-4 w-full rounded-xl border-2 border-tokyu-ink object-cover" %>
  <% end %>
  <p class="mb-2 text-lg font-bold break-words">「<%= @entry.title %>」</p>
  <p class="mb-4 text-tokyu-ink-soft last:mb-0"><%= @entry.user.name %></p>
  <% if @entry.description.present? %>
    <p class="whitespace-pre-wrap break-words"><%= @entry.description %></p>
  <% end %>
</div>

<div class="card mb-8">
  <% if @entry.user_id == current_user.id %>
    <p class="text-sm text-tokyu-ink-soft">自分のエントリーには投票できません。</p>
  <% elsif @voted %>
    <p class="text-sm font-bold text-tokyu-pink-dark">このエントリーには投票済みです。</p>
  <% elsif !@event.open? %>
    <p class="text-sm text-tokyu-ink-soft">投票を受け付けていません。</p>
  <% elsif @remaining_votes <= 0 %>
    <p class="text-sm text-tokyu-ink-soft">この部門の票を使い切りました。</p>
  <% else %>
    <%= form_with model: @vote, url: event_votes_path(@event) do |f| %>
      <%= f.hidden_field :entry_id, value: @entry.id %>
      <%= f.label :comment, "コメントを記入する【任意】", class: "label" %>
      <span class="mb-2 block text-xs text-tokyu-ink-soft">300文字まで</span>
      <%= f.text_area :comment, rows: 5,
                      class: "input mb-6" %>
      <div class="text-center">
        <%= f.submit "投票する（残り #{@remaining_votes} 票）",
                   class: "btn-primary" %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="text-center">

  <%= link_to "戻る", event_entries_path(@event, category: @category.category_name),
            class: "btn-secondary" %>

</div>
