<% content_for :title, "投票する" %>
<h1 class="page-title">投票する</h1>

<div class="card mt-4">
  <% if @entry.image.attached? %>
    <%= image_tag @entry.image, class: "mb-4 w-full rounded object-cover" %>
  <% end %>
  <p class="text-lg font-bold break-words">「<%= @entry.title %>」</p>
  <p class="mt-1 text-stone-600"><%= @entry.user.name %></p>
  <% if @entry.description.present? %>
    <p class="mt-3 whitespace-pre-wrap break-words text-stone-700"><%= @entry.description %></p>
  <% end %>
</div>

<div class="card mt-6">
  <% if @entry.user_id == current_user.id %>
    <p class="text-sm text-stone-500">自分のエントリーには投票できません。</p>
  <% elsif @voted %>
    <p class="text-sm text-tokyu-pink-dark">このエントリーには投票済みです。</p>
  <% elsif !@event.open? %>
    <p class="text-sm text-stone-500">投票を受け付けていません。</p>
  <% elsif @remaining_votes <= 0 %>
    <p class="text-sm text-stone-500">この部門の票を使い切りました。</p>
  <% else %>
    <%= form_with model: @vote, url: event_votes_path(@event) do |f| %>
      <%= f.hidden_field :entry_id, value: @entry.id %>
      <%= f.label :comment, "コメントを記入する【任意】", class: "block text-sm font-bold" %>
      <span class="text-xs text-stone-500">300文字まで</span>
      <%= f.text_area :comment, rows: 5,
                      class: "input mt-2" %>
      <div class="mt-4 text-center">
        <%= f.submit "投票する（残り #{@remaining_votes} 票）",
                   class: "btn-primary" %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="mt-8 text-center">

  <%= link_to "戻る", event_entries_path(@event, category: @category.category_name),
            class: "btn-secondary" %>

</div>
