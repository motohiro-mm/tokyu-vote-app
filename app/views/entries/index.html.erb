<% content_for :title, "#{@category.label}に投票する" %>
<div class="flex items-center justify-between gap-4">
  <h1 class="page-title text-left"><%= @category.label %>に投票する</h1>
  <%# 会場で候補が増えていくため、その場で一覧を取り直せるようにする %>
  <%= link_to "更新", request.fullpath, class: "btn-secondary shrink-0", data: { turbo_action: "replace" } %>
</div>

<div class="card mt-4">
  <p>投票できる数: <span class="font-bold"><%= @remaining_votes %></span> 票</p>

  <% if @voted_entries.present? %>
    <p class="mt-3 text-sm text-stone-600">あなたが投票したのは以下のエントリーです</p>
    <ul class="mt-1 text-sm">
      <% @voted_entries.each do |entry| %>
        <li class="py-1"><%= entry.user.name %> さんの「<%= entry.title %>」</li>
      <% end %>
    </ul>
  <% end %>
</div>

<% if @entries.empty? %>
  <p class="mt-6 text-stone-600">エントリーされていません。</p>
<% else %>
  <ul class="mt-6 space-y-3">
    <% @entries.each do |entry| %>
      <li class="card flex items-center gap-4">
        <% if entry.image.attached? %>
          <%= image_tag entry.image, class: "h-16 w-16 rounded object-cover" %>
        <% end %>
        <div class="min-w-0 flex-1">
          <p class="font-bold break-words"><%= entry.title %></p>
          <p class="text-sm text-stone-500"><%= entry.user.name %></p>
          <% if entry.description.present? %>
            <p class="mt-1 text-xs break-words text-stone-500"><%= entry.description %></p>
          <% end %>
        </div>
        <% if entry.user_id == current_user.id %>
          <span class="shrink-0 text-sm text-stone-500">自分の作品</span>
        <% elsif @voted_entry_ids.include?(entry.id) %>
          <span class="badge-done">投票済み</span>
        <% else %>
          <%= link_to "選択する", event_entry_path(@event, entry, category: @category.category_name),
                      class: "btn-primary shrink-0" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<div class="mt-8 text-center">

  <%= link_to "戻る", event_votes_categories_path(@event), class: "btn-secondary" %>

</div>
