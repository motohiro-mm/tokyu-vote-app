<% content_for :title, "エントリーする" %>
<h1 class="page-title mb-6">エントリーする</h1>

<ul class="mb-8 space-y-4">
  <% @categories.each do |category| %>
    <li>
      <%= link_to new_event_entry_path(@event, category: category.category_name),
                  class: "card-link" do %>
        <span class="font-bold"><%= category.label %>に登録する</span>
      <% end %>
    </li>
  <% end %>
</ul>

<div class="text-center">

  <%= link_to "戻る", event_path(@event), class: "btn-secondary" %>

</div>
