<% content_for :title, @event.title %>
<h1 class="page-title"><%= @event.title %></h1>

<% if @event.results_published? %>
  <h2 class="mt-8 text-center section-title">投票結果</h2>
  <ul class="mt-3 space-y-3">
    <% @categories.each do |category| %>
      <li>
        <%= link_to "#{category.label}の結果を見る", event_results_path(@event, category: category.category_name),
                    class: "card-link text-center font-bold" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mt-8 space-y-4">
    <%= link_to "#{Category.for_entries.joined_label}にエントリーする", event_entries_categories_path(@event),
                class: "card-link text-center text-lg font-bold" %>
    <%= link_to "#{Category.joined_label}に投票する", event_votes_categories_path(@event),
                class: "card-link text-center text-lg font-bold" %>
  </div>
<% end %>
