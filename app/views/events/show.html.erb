<% content_for :title, @event.title %>
<h1 class="text-xl font-bold"><%= @event.title %></h1>
<p class="mt-3 text-stone-600">
  このアプリでは飯王と酒王への参加登録と、
  各部門（飯王・酒王・LT王）にそれぞれ最大3票まで投票できます。
</p>

<% if @event.closed? %>
  <h2 class="mt-8 font-bold">投票結果</h2>
  <ul class="mt-2 space-y-3">
    <% @categories.each do |category| %>
      <li>
        <%= link_to "#{category.label}の結果を見る", event_results_path(@event, category: category.category_name),
                    class: "block rounded border border-stone-200 bg-white px-5 py-4 hover:bg-stone-100" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <h2 class="mt-8 font-bold">エントリーする</h2>
  <%= link_to "飯王・酒王に登録する", event_entries_categories_path(@event),
              class: "mt-2 block rounded border border-stone-200 bg-white px-5 py-4 hover:bg-stone-100" %>

  <h2 class="mt-6 font-bold">投票する</h2>
  <%= link_to "部門を選んで投票する", event_votes_categories_path(@event),
              class: "mt-2 block rounded border border-stone-200 bg-white px-5 py-4 hover:bg-stone-100" %>
<% end %>
