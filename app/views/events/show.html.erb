<% content_for :title, @event.title %>
<div class="text-center">
  <h1 class="page-title"><%= @event.title %></h1>
  <p class="mt-4 leading-relaxed text-stone-700">
    このアプリでは飯王と酒王への参加登録と、<br>
    各部門（飯王・酒王・LT王）にそれぞれ最大3票まで投票できます。
  </p>
</div>

<% if @event.closed? %>
  <h2 class="mt-8 section-title">投票結果</h2>
  <ul class="mt-2 space-y-3">
    <% @categories.each do |category| %>
      <li>
        <%= link_to "#{category.label}の結果を見る", event_results_path(@event, category: category.category_name),
                    class: "card-link" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <h2 class="mt-8 section-title">エントリーする</h2>
  <%= link_to "飯王・酒王に登録する", event_entries_categories_path(@event),
              class: "card-link mt-2" %>

  <h2 class="mt-6 section-title">投票する</h2>
  <%= link_to "部門を選んで投票する", event_votes_categories_path(@event),
              class: "card-link mt-2" %>
<% end %>
