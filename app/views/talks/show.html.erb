<% content_for :title, "投票する" %>
<h1 class="page-title mb-6">投票する</h1>

<div class="card mb-6">
  <p class="mb-2 text-lg font-bold break-words">「<%= @talk.title %>」</p>
  <p class="mb-4 text-tokyu-ink-soft last:mb-0"><%= @talk.user_name %></p>
  <% if @talk.description.present? %>
    <p class="mb-4 whitespace-pre-wrap break-words last:mb-0"><%= @talk.description %></p>
  <% end %>
  <% if (slide_url = @talk.safe_slide_url) %>
    <%= link_to "発表資料", slide_url, target: "_blank", rel: "noopener noreferrer", class: "text-link" %>
  <% end %>
</div>

<div class="card mb-8">
  <% if @cast_vote %>
    <div class="mb-6 last:mb-0">
      <p class="mb-2 text-sm font-bold text-tokyu-pink-dark last:mb-0">このLTには投票済みです。</p>
      <% if @cast_vote.comment.present? %>
        <p class="text-sm whitespace-pre-wrap break-words text-tokyu-ink-soft"><%= @cast_vote.comment %></p>
      <% end %>
    </div>
    <% if @event.open? %>
      <div class="text-center">
        <%= button_to "投票を取り消す", event_talk_vote_path(@event.slug, @cast_vote), method: :delete, class: "btn-secondary",
                    form: { data: { turbo_confirm: "投票を取り消します。コメントも消えます。よろしいですか？" } } %>
      </div>
    <% end %>
  <% elsif !@event.open? %>
    <p class="text-sm text-tokyu-ink-soft">投票を受け付けていません。</p>
  <% elsif @remaining_votes <= 0 %>
    <p class="text-sm text-tokyu-ink-soft"><%= @category.label %>の票を使い切りました。</p>
  <% else %>
    <%= form_with model: @talk_vote, url: event_talk_votes_path(@event.slug) do |f| %>
      <%= f.hidden_field :talk_id, value: @talk.id %>
      <%= f.label :comment, "コメントを記入する【任意】", class: "label" %>
      <span class="mb-2 block text-xs text-tokyu-ink-soft">300文字まで</span>
      <%= f.text_area :comment, rows: 5,
                      class: "input mb-6" %>
      <div class="text-center">
        <%= f.submit "投票する（残り #{@remaining_votes} 票）",
                   class: "btn-primary" %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="text-center">

  <%= link_to "戻る", event_talks_path(@event.slug), class: "btn-secondary" %>

</div>
