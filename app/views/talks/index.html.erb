<% content_for :title, "#{@category.label}に投票する" %>
<div class="flex items-center justify-between gap-4">
  <h1 class="page-title text-left"><%= @category.label %>に投票する</h1>
  <%# 会場で候補が増えていくため、その場で一覧を取り直せるようにする %>
  <%= link_to "更新", request.fullpath, class: "btn-secondary shrink-0", data: { turbo_action: "replace" } %>
</div>

<div class="card mt-4">
  <p>投票できる数: <span class="font-bold"><%= @remaining_votes %></span> 票</p>

  <% if @voted_talks.present? %>
    <p class="mt-3 text-sm text-stone-600">あなたが投票したのは以下のLTです</p>
    <ul class="mt-1 text-sm">
      <% @voted_talks.each do |talk| %>
        <li class="py-1"><%= talk.user_name %> さんの「<%= talk.title %>」</li>
      <% end %>
    </ul>
  <% end %>
</div>

<% if @talks.empty? %>
  <p class="mt-6 text-stone-600">LTが登録されていません。</p>
<% else %>
  <ul class="mt-6 space-y-3">
    <% @talks.each do |talk| %>
      <li class="card flex items-center gap-4">
        <div class="min-w-0 flex-1">
          <p class="font-bold break-words"><%= talk.title %></p>
          <p class="text-sm text-stone-500"><%= talk.user_name %></p>
        </div>
        <% if @voted_talk_ids.include?(talk.id) %>
          <span class="badge-done">投票済み</span>
        <% else %>
          <%= link_to "選択する", event_talk_path(@event, talk),
                      class: "btn-primary shrink-0" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<div class="mt-8 text-center">

  <%= link_to "戻る", event_votes_categories_path(@event), class: "btn-secondary" %>

</div>
